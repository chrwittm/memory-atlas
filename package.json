{
  "name": "memory-atlas",
  "productName": "Memory Atlas",
  "private": true,
  "version": "0.2.0",
  "description": "A local-first viewer for rediscovering photos through their embedded context.",
  "engines": {
    "node": ">=20.18.0 <21"
  },
  "packageManager": "npm@10.9.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "desktop": "npm run build && electron-forge start",
    "package:mac": "npm run build && electron-forge package --platform=darwin",
    "make:mac": "npm run check && npm test && npm run build && electron-forge make --platform=darwin",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "exifreader": "^4.31.1",
    "maplibre-gl": "^5.2.0",
    "svelte": "^5.25.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@types/node": "^22.13.10",
    "electron": "^41.7.1",
    "jsdom": "^26.0.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.8"
  }
}
